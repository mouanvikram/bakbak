{
  "name": "bakbak",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend dev:prisma",
    "dev:frontend": "bun --cwd apps/web dev",
    "dev:backend": "bun --watch apps/api/index.ts",
    "dev:prisma": "bun --cwd packages/db dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres minio minio-init",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "bun --cwd packages/db migrate",
    "db:migrate:deploy": "bun --cwd packages/db migrate:deploy",
    "db:seed": "bun apps/api/src/seed/seed.ts",
    "test": "bun --cwd apps/api test",
    "test:docker": "docker compose -f infra/docker-compose.yml --profile test run --rm tests"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
