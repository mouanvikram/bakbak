{
  "name": "bakbak",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend dev:prisma",
    "dev:frontend": "bun --cwd apps/web dev",
    "dev:backend": "bun --watch apps/api/index.ts",
    "dev:prisma": "bun --cwd packages/db dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "bun --cwd packages/db migrate",
    "db:migrate:deploy": "bun --cwd packages/db migrate:deploy",
    "test": "bun --cwd apps/api test",
    "test:docker": "docker compose -f infra/docker-compose.yml --profile test run --rm --build tests",
    "lint": "bun --cwd apps/api lint && bun --cwd apps/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "8.0.0-rc.15",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/composer": "0.20.0",
    "@prisma/composer-prisma-cloud": "0.20.0",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  }
}
