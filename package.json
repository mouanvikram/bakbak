{
  "name": "bakbak",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend dev:prisma",
    "dev:frontend": "bun --cwd apps/web dev",
    "dev:backend": "bun --watch apps/api/index.ts",
    "dev:prisma": "bun --cwd packages/db dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "pino-pretty": "^13.1.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "helmet": "^8.3.0"
  }
}