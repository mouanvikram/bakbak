root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# apps/api and packages/* are tab-indented.
[*.{ts,tsx,js,json}]
indent_style = tab

# apps/web was authored with 2-space indentation (Prettier defaults).
[apps/web/**.{ts,tsx,js,css,html}]
indent_style = space
indent_size = 2

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2
