# Copy to .env on the coturn host.

# This box's Elastic IP. An ephemeral public IP changes on stop/start and the
# advertised relay candidate goes stale, so allocate an EIP and attach it.
TURN_EXTERNAL_IP=

# Must byte-for-byte match TURN_STATIC_AUTH_SECRET in the API's environment —
# the API derives credentials from it and coturn recomputes the same HMAC.
# Generate with: openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=

# Must match TURN_REALM in the API's environment, or coturn rejects the
# credential the API minted.
TURN_REALM=bakbak.local
