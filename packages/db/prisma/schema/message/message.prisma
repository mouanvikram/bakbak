enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STICKER
  LOCATION
  CONTACT
  CALL
  SYSTEM
}

model Message {
  id   String      @id @default(uuid()) @db.Uuid()
  type MessageType @default(TEXT)
  text String?

  clientId String @db.Uuid

  senderId String @db.Uuid
  chatId   String @db.Uuid
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender   User   @relation(fields: [senderId], references: [id], onDelete: NoAction)

  // Reply
  replyToId String?   @db.Uuid
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: NoAction)
  replies   Message[] @relation("MessageReplies")

  attachments Attachment[]
  reactions   MessageReaction[]

  //life-cycle
  deletedAt DateTime?
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([senderId, clientId])
  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid()
  emoji     String
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}
