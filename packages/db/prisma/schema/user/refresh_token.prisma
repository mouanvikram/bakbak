model RefreshToken{
    id String @id @default(uuid()) @db.Uuid

    userId String @db.Uuid
    tokenHash String

    // Stable login-session id: set at login, inherited by every rotated token,
    // and carried in the access token as `sid`. Revoking one revokes the chain.
    sessionId String? @db.Uuid

    // User-Agent captured at login; labels sessions on the Devices page.
    userAgent String?

    expiresAt DateTime
    revokedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId],references: [id],onDelete: Cascade)

    @@index([userId])
    @@index([tokenHash])
    @@index([sessionId])
}