model RefreshToken{
    id String @id @default(uuid()) @db.Uuid

    userId String @db.Uuid
    tokenHash String

    expiresAt DateTime
    revokedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId],references: [id],onDelete: Cascade)

    @@index([userId])
    
}