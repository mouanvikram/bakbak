model User {
  id String @id @default(uuid(7)) @db.Uuid

  email        String @unique @db.VarChar(320)
  username     String @unique @db.VarChar(30)
  passwordHash String

  isEmailVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  verification     VerificationToken[]
  profile          UserProfile?
  refreshToken     RefreshToken[]
  sentRequests     FriendRequest[]     @relation("FriendRequestSender")
  receivedRequests FriendRequest[]     @relation("FriendRequestReceiver")

  friendships1 Friendship[] @relation("FriendshipUser1")
  friendships2 Friendship[] @relation("FriendshipUser2")
}

model UserProfile {
    userId String @id @db.Uuid

    username    String @unique
    displayName String?
    firstName   String?
    lastName    String?

    avatar String?
    bio    String?

    isOnline  Boolean  @default(false)
    lastSeenAt DateTime?

    user User @relation(fields: [userId], references: [id],onDelete: Cascade)
}
