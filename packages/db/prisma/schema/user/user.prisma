model User {
  id String @id @default(uuid()) @db.Uuid

  // citext: case-insensitive comparison/uniqueness at the DB level. The app
  // also normalizes both to lowercase before every write (see contracts'
  // emailSchema/usernameSchema) — citext is the backstop for any write path
  // that doesn't go through those schemas.
  email        String @unique @db.Citext
  username     String @unique @db.Citext
  passwordHash String

  isEmailVerified Boolean @default(false)

  // Brute-force login protection
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Brute-force protection for 2FA code verification (login + setup)
  twoFactorFailedAttempts Int       @default(0)
  twoFactorLockedUntil    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  profile  UserProfile?
  settings UserSettings?

  verification VerificationToken[]
  refreshToken RefreshToken[]
  sessions     Session[]

  sentRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedRequests FriendRequest[] @relation("FriendRequestReceiver")

  friendShips1 Friendship[] @relation("FriendshipUser1")
  friendShips2 Friendship[] @relation("FriendshipUser2")

  chats        ChatParticipant[]
  createdChats Chat[]            @relation("CreatedChats")

  messages Message[]
}

enum GenderType {
  MALE
  FEMALE
}

model UserProfile {
  userId String @id @db.Uuid

  displayName String?
  firstName   String?
  lastName    String?

  avatar String?
  bio    String?
  dob    String?
  gender GenderType @default(MALE)

  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NotificationsPage
  notifyMessages Boolean @default(true)
  notifySounds   Boolean @default(true)
  notifyAlerts   Boolean @default(true)
  emailDigest    Boolean @default(false)

  // AppearancePage
  theme    String @default("light") @db.VarChar(10)
  fontSize String @default("small") @db.VarChar(10)

  // ChatSettingsPage
  enterToSend  Boolean @default(true)
  mediaPreview Boolean @default(true)

  // SecurityPrivacyPage (2FA toggle)
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
