model User {
  id String @id @default(uuid()) @db.Uuid

  email        String @unique @db.VarChar(320)
  username     String @unique @db.VarChar(30)
  passwordHash String

  isEmailVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  verification     VerificationToken[]
  profile          UserProfile?
  settings         UserSettings?
  refreshToken     RefreshToken[]
  sentRequests     FriendRequest[]     @relation("FriendRequestSender")
  receivedRequests FriendRequest[]     @relation("FriendRequestReceiver")

  friendShips1 Friendship[] @relation("FriendshipUser1")
  friendShips2 Friendship[] @relation("FriendshipUser2")

  chats        ChatParticipant[]
  createdChats Chat[]            @relation("CreatedChats")

  messages Message[]
}

enum GenderType {
  MALE
  FEMALE
}

model UserProfile {
  userId String @id @db.Uuid

  displayName String?
  firstName   String?
  lastName    String?

  avatar String?
  bio    String?
  dob    String?
  gender GenderType @default(MALE)

  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per user, created lazily on first access.
// Mirrors the fields rendered by the frontend settings pages:
// NotificationsPage, AppearancePage, ChatSettingsPage, SecurityPrivacyPage.
model UserSettings {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NotificationsPage
  notifyMessages Boolean @default(true)
  notifySounds   Boolean @default(true)
  notifyAlerts   Boolean @default(true)
  emailDigest    Boolean @default(false)

  // AppearancePage
  theme    String @default("system") @db.VarChar(10)
  fontSize String @default("medium") @db.VarChar(10)

  // ChatSettingsPage
  enterToSend     Boolean @default(true)
  mediaPreview    Boolean @default(true)
  keepChatHistory Boolean @default(true)

  // SecurityPrivacyPage (2FA toggle)
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
