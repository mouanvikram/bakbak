# Copy this file to `.env` at the repo root.

# ── Database ────────────────────────────────────────────────────────────
# The @bakbak/db package picks one of these by NODE_ENV:
#   production → PRODUCTION_DB_URL   (your managed/hosted database)
#   test       → DEV_DB_TEST_URL     (throwaway — the suite truncates it)
#   otherwise  → DEV_DB_URL          (local Postgres from infra/docker-compose)
# Set DATABASE_URL to override all three (useful for one-off scripts).
PRODUCTION_DB_URL=postgresql://user:password@db.example.com:5432/bakbak
DEV_DB_URL=postgresql://bakbak:bakbak@localhost:5432/bakbak_dev
DEV_DB_TEST_URL=postgresql://bakbak:bakbak@localhost:5432/bakbak_test
# DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in verification / reset emails
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Rate limiting (optional — these are the defaults)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Email delivery (Resend) — required for verification & password reset
RESEND_API_KEY=re_xxxxxxxxxxxx

# Object storage (MinIO / S3-compatible). Defaults target a local MinIO instance.
# To switch to Amazon S3, keep the same vars but omit STORAGE_ENDPOINT/PORT/USE_SSL
# and set region + keys to your AWS account (and enable forcePathStyle off if needed).
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=bakbak
# Optional public/CDN base URL prefix; when set, URLs are served from here instead
# of generated as signed URLs. Leave empty to use signed URLs.
STORAGE_PUBLIC_URL=

# Frontend — base URL of the API server (used for REST + the Socket.IO
# connection). Leave unset for a single-origin deploy where the web server
# proxies /api and /socket.io.
VITE_API_URL=http://localhost:3000