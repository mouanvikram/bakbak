# Copy this file to `.env` at the repo root.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bakbak

# Server
PORT=3000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in verification / reset emails
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Rate limiting (optional — these are the defaults)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Email delivery (Resend) — required for verification & password reset
RESEND_API_KEY=re_xxxxxxxxxxxx

# Frontend
VITE_API_URL=http://localhost:5173