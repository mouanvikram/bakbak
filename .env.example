# production database url
PRODUCTION_DB_URL="<your_production_db_url>"
# development database url
DEV_DB_URL="postgresql://bakbak:bakbak@localhost:5432/bakbak_dev"
# test database url
DEV_DB_TEST_URL="postgresql://bakbak:bakbak@localhost:5432/bakbak_test"
# overrides all three above when set (one-off scripts, prisma CLI runs)
DATABASE_URL=

# node environment
NODE_ENV=development
PORT=3000
# number of proxy hops to trust for the client IP (0 = none; 1 behind one LB)
TRUST_PROXY=

# logging
# log level; defaults to "debug" in dev, "info" in production
LOG_LEVEL=
# pretty-print logs in the terminal (true|false); defaults to false — set to
# true for the local dev loop, leave unset/false for anything deployed
LOG_PRETTY=

# jwt
# REQUIRED in every environment; production also requires >= 32 characters.
JWT_SECRET=
# token issuer / audience claims; default to bakbak-api / bakbak-web
JWT_ISSUER=
JWT_AUDIENCE=

# refresh-token cookie (httpOnly)
# SameSite: strict (default — the web app reaches the API same-origin through
# the Vite proxy / a rewrite), lax, or none (cross-site API only; forces Secure)
AUTH_COOKIE_SAMESITE=
# Secure flag (true|false); defaults to true in production, false elsewhere so
# plain http://localhost works
AUTH_COOKIE_SECURE=
# resend api key
# REQUIRED in every environment.
RESEND_API_KEY=re_test_key

# login protection
# failed attempts before lockout, and how long the lockout lasts (ms)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000
# how long before a username can be changed again (ms; default 6 months)
USERNAME_CHANGE_COOLDOWN_MS=

# vite and cross origin
# frontend url
# REQUIRED in production — it is the base for verification / reset / recovery
# links in outbound email, and a localhost value is rejected at boot there.
FRONTEND_URL=
# vite api url
VITE_API_URL=
# cors origins
# REQUIRED in production — the localhost defaults are dev-only and a localhost
# entry here is rejected at boot in production.
CORS_ORIGINS=

# DEV_INBOX
DEV_INBOX=<your_own_email_for_testing>

# SeaweedFS / S3-compatible object storage
# The values below are the local docker-compose defaults. STORAGE_ENDPOINT,
# STORAGE_ACCESS_KEY and STORAGE_SECRET_KEY are REQUIRED in production and
# these dev values are rejected there rather than silently reused.
# SeaweedFS's S3 gateway listens on port 8333 (fixed in `weed server -s3` mode).
STORAGE_ENDPOINT=localhost
STORAGE_PORT=8333
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=seaweedfs
STORAGE_SECRET_KEY=seaweedfs
STORAGE_BUCKET=bakbak
STORAGE_PUBLIC_URL=
# lifetime of signed attachment/avatar URLs (seconds; default 3600)
SIGNED_URL_TTL_SECONDS=

# Redis
# redis url
# full connection string (redis:// or rediss:// with optional credentials and
# /db path); takes precedence over the host/port form below
REDIS_URL=
# redis host
REDIS_HOST=
# redis port
REDIS_PORT=
# optional password / logical db index / TLS for the host+port form.
# rediss:// in REDIS_URL implies TLS the same way REDIS_TLS=true does.
REDIS_PASSWORD=
REDIS_DB=
REDIS_TLS=false
# cache default ttl in seconds
CACHE_DEFAULT_TTL_SEC=
# per-entity cache lifetimes (seconds); both are invalidated on writes, so
# these only bound how long a missed invalidation can linger
FRIENDS_LIST_CACHE_TTL_SEC=300
FRIEND_SUGGESTIONS_CACHE_TTL_SEC=60
# rate limit global capacity
RATE_LIMIT_GLOBAL_CAPACITY=
# rate limit global refill per second
RATE_LIMIT_GLOBAL_REFILL_PER_SEC=4
# rate limit login capacity
RATE_LIMIT_LOGIN_CAPACITY=20
# rate limit login refill per second
RATE_LIMIT_LOGIN_REFILL_PER_SEC=0.333
# rate limit email capacity
RATE_LIMIT_EMAIL_CAPACITY=8
# rate limit email refill per second
RATE_LIMIT_EMAIL_REFILL_PER_SEC=0.0083
# rate limit uploads capacity
RATE_LIMIT_UPLOADS_CAPACITY=20
# rate limit uploads refill per second
RATE_LIMIT_UPLOADS_REFILL_PER_SEC=0.333
# rate limit message send capacity
RATE_LIMIT_MESSAGE_SEND_CAPACITY=60
# rate limit message send refill per second
RATE_LIMIT_MESSAGE_SEND_REFILL_PER_SEC=2
# rate limit username check capacity
RATE_LIMIT_USERNAME_CHECK_CAPACITY=20
# rate limit username check refill per second
RATE_LIMIT_USERNAME_CHECK_REFILL_PER_SEC=1
# rate limit friend request capacity
RATE_LIMIT_FRIEND_REQUEST_CAPACITY=20
# rate limit friend request refill per second
RATE_LIMIT_FRIEND_REQUEST_REFILL_PER_SEC=0.05
# rate limit chat capacity
RATE_LIMIT_CHAT_CAPACITY=25
# rate limit chat refill per second
RATE_LIMIT_CHAT_REFILL_PER_SEC=0.125
# rate limit settings (preference writes) capacity / refill per second
RATE_LIMIT_SETTINGS_CAPACITY=30
RATE_LIMIT_SETTINGS_REFILL_PER_SEC=0.25
# rate limit password change capacity / refill per second
RATE_LIMIT_PASSWORD_CHANGE_CAPACITY=10
RATE_LIMIT_PASSWORD_CHANGE_REFILL_PER_SEC=0.016
# rate limit session listing / revocation capacity / refill per second
RATE_LIMIT_SESSIONS_CAPACITY=30
RATE_LIMIT_SESSIONS_REFILL_PER_SEC=0.1
# rate limit two-factor enrolment management capacity / refill per second
RATE_LIMIT_TWO_FACTOR_MANAGE_CAPACITY=10
RATE_LIMIT_TWO_FACTOR_MANAGE_REFILL_PER_SEC=0.016

# Presence (Redis socket leases)
# how long a socket's lease lives without a heartbeat, how often each socket
# heartbeats, and how often the sweep marks expired users offline (ms)
PRESENCE_SOCKET_TTL_MS=90000
PRESENCE_HEARTBEAT_MS=30000
PRESENCE_SWEEP_MS=30000

# Loki (observability) — optional structured log shipping. Leave LOKI_URL empty
# to keep plain stdout logs; with the local stack (`bun run infra:observer`) use
# http://localhost:3100. See "Getting Started" in README.md.
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=

# Prometheus metrics — bearer token protecting GET /metrics. When set, scrapers
# must send `Authorization: Bearer <token>` (constant-time compared). Leave
# empty to keep the endpoint public for local dev; the API warns on boot if it
# is unset in production. Generate one with `openssl rand -hex 32`.
METRICS_AUTH_TOKEN=

# Grafana (observability stack) — admin login and public URL
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

# Pin tags for reproducible deploys once you've picked a version
PROMETHEUS_VERSION=
GRAFANA_VERSION=
LOKI_VERSION=

# Build stamping (set by CI, not locally) — the API serves APP_VERSION at
# GET /api/v1/version and the web build compares it to VITE_APP_VERSION to
# detect a stale tab. GIT_COMMIT falls back to VERCEL_GIT_COMMIT_SHA.
APP_VERSION=
GIT_COMMIT=
BUILD_TIME=
VITE_APP_VERSION=

# Web push (VAPID) — browser notifications for new messages, delivered even
# when the tab is closed. Generate a pair with `bunx web-push generate-vapid-keys`.
# REQUIRED in production — without them the API boot fails there. In dev, an
# empty value disables push (GET /api/v1/push/config returns null).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto address the push service can contact the operator at
VAPID_SUBJECT=mailto:dev@bakbak.local

# WebRTC calls (coturn) — STUN lets a browser find its own public address;
# TURN relays the media when the peers' NATs won't open a direct path.
# Comma-separated, so one variable can carry a udp/tcp pair. The defaults
# match the coturn service in infra/docker-compose.yml.
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478
# Shared secret between the API and coturn (coturn `--use-auth-secret`). The
# API derives short-lived credentials from it; it is never sent to a browser.
# REQUIRED in production, where this dev value is rejected at boot.
TURN_STATIC_AUTH_SECRET=dev-turn-secret
# Must match coturn's --realm, or it rejects the minted credential.
TURN_REALM=bakbak.local
# lifetime of a minted TURN credential (seconds; default 3600)
TURN_CREDENTIAL_TTL_SECONDS=
# The address clients actually reach coturn on. Without it coturn advertises
# its container IP (172.x) as the relay address, and TURN allocations are
# unusable from outside the Docker network — STUN still works, so calls
# connect whenever a direct path exists and fail only when a relay was needed.
# Set this and uncomment --external-ip in infra/docker-compose.yml.
TURN_EXTERNAL_IP=
