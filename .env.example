# Copy this file to `.env` at the repo root.

# ── Database ────────────────────────────────────────────────────────────
# The @bakbak/db package picks one of these by NODE_ENV:
#   production → PRODUCTION_DB_URL   (your managed/hosted database)
#   test       → DEV_DB_TEST_URL     (throwaway — the suite truncates it)
#   otherwise  → DEV_DB_URL          (local Postgres from infra/docker-compose)
# Set DATABASE_URL to override all three (useful for one-off scripts).
PRODUCTION_DB_URL=postgresql://user:password@db.example.com:5432/bakbak
DEV_DB_URL=postgresql://bakbak:bakbak@localhost:5432/bakbak_dev
DEV_DB_TEST_URL=postgresql://bakbak:bakbak@localhost:5432/bakbak_test
# DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Build info (optional — CI stamps these; served at GET /api/v1/version so the
# web app can detect a stale bundle). Defaults: "dev" / "unknown" / process start.
# APP_VERSION=
# GIT_COMMIT=
# BUILD_TIME=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in verification / reset emails
FRONTEND_URL=http://localhost:5173

# Log verbosity: trace|debug|info|warn|error|fatal.
# Default: info in production, debug elsewhere.
LOG_LEVEL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Token issuer/audience claims (defaults: bakbak-api / bakbak-web).
JWT_ISSUER=
JWT_AUDIENCE=
# Password brute-force policy (defaults: 5 attempts, 15 min lockout).
LOGIN_MAX_ATTEMPTS=
LOGIN_LOCKOUT_MS=

# Rate limiting (per-IP token buckets; defaults live in src/redis/config.ts —
# set only the ones you need to override).
REDIS_HOST=
REDIS_PORT=
# Default TTL for cached values, seconds (default 300).
CACHE_DEFAULT_TTL_SEC=
# Reverse-proxy hops in front of the API (e.g. 1 behind Nginx/Caddy, 2 behind
# a CDN). Set ONLY if actually proxied; unset = req.ip is the socket peer and
# X-Forwarded-For is ignored.
# TRUST_PROXY=1
# Global bucket: burst capacity + sustained refill per second, per IP.
RATE_LIMIT_GLOBAL_CAPACITY=
RATE_LIMIT_GLOBAL_REFILL_PER_SEC=
# Per-route buckets (same capacity/refill shape; per-user where noted).
RATE_LIMIT_LOGIN_CAPACITY=
RATE_LIMIT_LOGIN_REFILL_PER_SEC=
RATE_LIMIT_EMAIL_CAPACITY=
RATE_LIMIT_EMAIL_REFILL_PER_SEC=
RATE_LIMIT_UPLOADS_CAPACITY=
RATE_LIMIT_UPLOADS_REFILL_PER_SEC=
RATE_LIMIT_MESSAGE_SEND_CAPACITY=
RATE_LIMIT_MESSAGE_SEND_REFILL_PER_SEC=
# Username-availability check (per IP — per-submitted-username buckets don't
# stop enumeration).
RATE_LIMIT_USERNAME_CHECK_CAPACITY=
RATE_LIMIT_USERNAME_CHECK_REFILL_PER_SEC=
# Friend-request send (per sender).
RATE_LIMIT_FRIEND_REQUEST_CAPACITY=
RATE_LIMIT_FRIEND_REQUEST_REFILL_PER_SEC=
# Chat create / add-member (per owner).
RATE_LIMIT_CHAT_CAPACITY=
RATE_LIMIT_CHAT_REFILL_PER_SEC=

# Email delivery (Resend) — required for verification & password reset
RESEND_API_KEY=re_xxxxxxxxxxxx

# Outside production EVERY outgoing mail is redirected here instead of the real
# recipient. Leave blank and non-prod mail is skipped (logged, not sent).
DEV_INBOX=

# Lifetime of every signed URL handed out (attachments and avatars), seconds.
SIGNED_URL_TTL_SECONDS=3600

# Object storage (MinIO / S3-compatible). Defaults target a local MinIO instance.
# To switch to Amazon S3, keep the same vars but omit STORAGE_ENDPOINT/PORT/USE_SSL
# and set region + keys to your AWS account (and enable forcePathStyle off if needed).
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=bakbak
# Optional public/CDN base URL prefix; when set, URLs are served from here instead
# of generated as signed URLs. Leave empty to use signed URLs.
STORAGE_PUBLIC_URL=

# Frontend — base URL of the API server (used for REST + the Socket.IO
# connection). Leave unset for a single-origin deploy where the web server
# proxies /api and /socket.io.
VITE_API_URL=http://localhost:3000